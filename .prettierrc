{
  "semi": false,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": true,
  "overrides": [
    { "files": "*.vue", "options": { "parser": "vue" } },
    { "files": "*.md", "options": { "parser": "markdown", "printWidth": 100, "proseWrap": "always" } }
  ]
}
