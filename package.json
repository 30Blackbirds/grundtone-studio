{
  "name": "grundtone-studio-monorepo",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Private commercial SaaS for configuring Grundtone design systems",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint && stylelint \"**/*.css\"",
    "lint:fix": "turbo run lint -- --fix && stylelint --fix \"**/*.css\"",
    "stylelint": "stylelint \"**/*.css\"",
    "format": "prettier --write \"**/*.{ts,tsx,vue,css,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,css,json,md,yml,yaml}\"",
    "check": "turbo run lint typecheck test && stylelint \"**/*.css\" && prettier --check \"**/*.{ts,tsx,vue,css,json,md,yml,yaml}\"",
    "studio": "pnpm --filter @grundtone-studio/studio",
    "saas-client": "pnpm --filter @grundtone/saas-client",
    "db:generate": "pnpm --filter @grundtone-studio/studio db:generate",
    "db:migrate:local": "pnpm --filter @grundtone-studio/studio db:migrate:local",
    "db:studio": "pnpm --filter @grundtone-studio/studio db:studio",
    "db:seed": "pnpm --filter @grundtone-studio/studio db:seed",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "changeset": "changeset",
    "release:sdk": "pnpm --filter @grundtone/saas-client build && changeset tag",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,css,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.5.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "devalue": "^5.8.1"
    },
    "overridesNotes": [
      "Force-bump transitive deps that have a high-severity advisory the upstream owner hasn't picked up yet. Each override needs a justification line below — re-evaluate periodically and remove the override once the natural tree resolves to the same or newer version.",
      "devalue ^5.8.1 — GHSA-77vg-94rm-hx3p, DoS via sparse-array deserialization in 5.6.3–5.8.0. Pulled in by @nuxtjs/i18n; remove when that package bumps."
    ]
  }
}
