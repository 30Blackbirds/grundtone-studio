{
  "name": "grundtone-studio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Private commercial SaaS for configuring Grundtone design systems",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . && stylelint \"**/*.css\"",
    "lint:fix": "eslint --fix . && stylelint --fix \"**/*.css\"",
    "format": "prettier --write \"**/*.{ts,tsx,vue,css,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,css,json,md,yml,yaml}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,css,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx,vue}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^22.15.17",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nuxt": "^3.19.2",
    "prettier": "^3.8.3",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.26",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "better-auth": "^1.6.6",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.3.6"
  }
}
