{
  "name": "@grundtone-studio/tokens-cli",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Headless CLI for managing Grundtone Studio project design tokens via a per-project secret key",
  "bin": {
    "grundtone-tokens": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "@types/node": "^22.15.17"
  }
}
