{
  "name": "@grundtone/saas-client",
  "private": true,
  "version": "0.0.0",
  "description": "Runtime SDK for Grundtone Studio — fetches tokens from CDN and applies them via @grundtone/core",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@grundtone/core": "^2.22.0"
  },
  "devDependencies": {
    "@grundtone/core": "^2.22.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0"
  }
}
