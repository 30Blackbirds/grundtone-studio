{
  "name": "@grundtone/saas-client",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.1",
  "description": "Runtime SDK for Grundtone Studio — fetches tokens from CDN and applies them as CSS variables",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@grundtone/core": "^3.2.0",
    "happy-dom": "^21.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^5.1.0"
  }
}
