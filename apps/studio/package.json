{
  "name": "@grundtone-studio/studio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Grundtone Studio — Nuxt 3 SaaS app",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "sh scripts/typecheck.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "bundle:size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1061.0",
    "@grundtone/core": "^2.22.0",
    "@grundtone/nuxt": "^2.23.3",
    "@grundtone/vue": "^2.23.3",
    "@nuxtjs/i18n": "^10.4.0",
    "@sentry/nuxt": "^10.56.0",
    "better-auth": "^1.6.14",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "marked": "^18.0.4",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.9",
    "tsx": "^4.22.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.9.0",
    "nuxt": "^3.19.2",
    "sass": "^1.99.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.26",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  }
}
