{
  "name": "@grundtone-studio/studio",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "version": "0.0.0",
  "description": "Grundtone Studio — Nuxt 3 SaaS app",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "sh scripts/typecheck.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude '**/*.{race,pg}.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "bundle:size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.0",
    "@connectrpc/connect-node": "^2.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/work-sans": "^5.3.0",
    "@grundtone-studio/dtcg": "workspace:*",
    "@grundtone/core": "^3.3.0",
    "@grundtone/icons": "^3.3.0",
    "@grundtone/nuxt": "^3.4.0",
    "@grundtone/utils": "^3.3.0",
    "@grundtone/vue": "^3.4.0",
    "@noble/hashes": "^2.4.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@sentry/nuxt": "^11.12.0",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "h3": "^1.15.11",
    "jose": "^6.2.17",
    "marked": "^18.2.0",
    "nodemailer": "^10.5.0",
    "openid-client": "6.9.0",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "vue": "^3.5.45",
    "vue-router": "^4.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@types/node": "^22.15.17",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "nuxt": "^3.21.10",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^2.2.10"
  }
}
