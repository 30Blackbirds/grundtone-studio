{
  "name": "@grundtone-studio/studio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Grundtone Studio — Nuxt 3 SaaS app",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "sh scripts/typecheck.sh",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --exclude '**/*.race.test.ts'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "bundle:size": "node scripts/bundle-size.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1073.0",
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.6.0",
    "@connectrpc/connect-node": "^1.6.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@grundtone/core": "^2.22.0",
    "@grundtone/nuxt": "^2.23.3",
    "@grundtone/vue": "^2.23.3",
    "@klanghaus/auth-jwt": "^0.2.0",
    "@klanghaus/permissions-client": "^0.3.0",
    "@noble/hashes": "^2.2.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/nuxt": "^10.59.0",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^0.45.2",
    "h3": "^1.15.11",
    "marked": "^18.0.5",
    "nodemailer": "^9.1.1",
    "postgres": "^3.4.9",
    "tsx": "^4.22.4",
    "vue": "^3.5.38",
    "vue-router": "^4.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.14.5",
    "nuxt": "^3.21.10",
    "sass": "^1.101.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^2.2.10"
  }
}
