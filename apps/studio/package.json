{
  "name": "@grundtone-studio/studio",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Grundtone Studio — Nuxt 3 SaaS app",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:migrate:local": "tsx --env-file=.env server/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@grundtone/core": "^2.22.0",
    "@grundtone/nuxt": "^2.23.3",
    "@grundtone/vue": "^2.23.3",
    "better-auth": "^1.6.6",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^8.0.5",
    "postgres": "^3.4.9",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "nuxt": "^3.19.2",
    "sass": "^1.99.0",
    "typescript": "^5.8.3",
    "vue": "^3.5.26",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  }
}
