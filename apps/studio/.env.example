# =============================================================================
# Grundtone Studio — local dev .env template
# =============================================================================
# Copy this file to `apps/studio/.env` and fill in real values. Every var the
# Nuxt app reads at runtime lives here. Deploy-environment secrets (PROD_*,
# STAGING_*, BUNNY_*) live in GitHub Environment secrets, not here.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local dev points at the Postgres container in docker-compose.yml (port 54320).
# Prod points at UpCloud Managed PostgreSQL via sslmode=require.
DATABASE_URL=postgresql://grundtone:grundtone_dev@127.0.0.1:54320/grundtone_studio

# -----------------------------------------------------------------------------
# Central auth service (studio no longer runs its own Better Auth instance)
# -----------------------------------------------------------------------------
# Base URL of the central auth service — used server-side as the JWT issuer,
# the session-cookie→JWT exchange host ({AUTH_ISSUER}/api/auth/token), and the
# JWKS source ({AUTH_ISSUER}/.well-known/jwks.json). Locally this is the auth
# container; in prod the auth deployment's https URL.
AUTH_ISSUER=http://localhost:3001
# JWT audience this app accepts — verificeret i server/middleware/auth.ts:49
# via createJwtVerifier({ issuer, audience }). Den SKAL matche den `aud`, den
# centrale auth udsteder for studio; gør den ikke det, fejler ALLE logins — og
# fejlen ser ud som om auth udsteder dårlige tokens, ikke som en forkert
# værdi her.
#
# 🔴 KONVENTIONEN ER `audience = issuer` (auth-tjenestens base-URL). Målt
# 2026-08-14 på de tre steder værdien findes:
#     prod-env              AUTH_ISSUER=…auth.klanghaus.dk  AUTH_AUDIENCE=https://auth.klanghaus.dk   ✔
#     docker-compose.tilt   AUTH_ISSUER=…localhost:8000     AUTH_AUDIENCE=http://localhost:8000       ✔
#     denne fil (før)       AUTH_ISSUER=…localhost:3001     AUTH_AUDIENCE=grundtone-studio            ✗
#
# Denne fil var den eneste der afveg — navne-form frem for baseURL-form. Den,
# der satte et nyt miljø op efter eksemplet, fik et studio ingen kunne logge
# ind i. Nu følger den samme konvention som de to kørende miljøer, anvendt på
# eksemplets EGEN issuer: den literale prod-hostname ville være lige så
# forkert lokalt, fordi en auth på :3001 ikke udsteder `aud` for :443.
AUTH_AUDIENCE=http://localhost:3001
# Browser-facing base URL of the central auth service. The Better Auth client
# (lib/auth-client.ts) points its baseURL here for sign-in, session,
# magic-link, and organization endpoints. Often the same as AUTH_ISSUER, but kept
# separate so server and browser can reach auth via different hostnames.
#
# Central auth must enable (see 30blackbirds [auth] repo):
#   - changeEmail, deleteUser, captcha (ALTCHA — selfhost PoW), sendResetPassword
#   - revokeSessionsOnPasswordReset: true
#   - user.deleted webhook → POST {STUDIO}/api/account/deleted
# Email templates: resetPasswordEmail, changeEmailConfirmationEmail,
# deleteAccountVerificationEmail in server/lib/email-templates.ts
NUXT_PUBLIC_AUTH_URL=http://localhost:3001
# Captcha = ALTCHA (selfhost proof-of-work, EU-først — ingen tredjeparts-script).
# Challenge-endpoint + HMAC-secret bor i central auth (ALTCHA_HMAC_KEY dér, ikke
# læst af Studio). Studio henter challengen same-origin via BFF og løser den
# klient-side; gaten er off indtil auth har nøglen sat.
# Server-only secret that studio's org-membership routes send to auth in the
# `x-klanghaus-org-write-credential` header (server/lib/org-membership.ts).
# Auth will refuse org-membership writes without it (ClickUp 1amk32fna12); the
# same value is set in auth. Never a NUXT_PUBLIC_* value. Required, at least 32
# bytes: without it, and without AUTH_INTERNAL_URL, those routes answer 503
# org_write_unconfigured and call nothing. In production AUTH_INTERNAL_URL must
# be https, or plain http only to localhost or a loopback/private IP LITERAL
# (never a hostname, not even a container name), and
# NODE_TLS_REJECT_UNAUTHORIZED must not be 0; otherwise the same 503.
ORG_WRITE_SERVICE_SECRET=

# -----------------------------------------------------------------------------
# Deployment choices — REQUIRED, no defaults (server/lib/runtime-flags.ts)
# -----------------------------------------------------------------------------
# Studio refuses to start when either is missing or unknown.
#   AUTHORIZER       pdp   = ask the permissions service below (PERMISSIONS_URL)
#                    local = decide from studio's own database (org_member,
#                            project_member, project_machine_grant)
#   FEATURE_BILLING  on    = checkout, the billing page and brand-count reports
#                    off   = those routes answer 404 and nothing is sent to account
AUTHORIZER=pdp
FEATURE_BILLING=on

# -----------------------------------------------------------------------------
# Central permissions PDP (Connect-RPC, server-to-server)
# -----------------------------------------------------------------------------
# Base URL of the Permissions service. Studio asks it for every authz decision
# and writes membership tuples on project create / member invite-accept.
PERMISSIONS_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Invite/accept link base — studio's own public URL (was BETTER_AUTH_URL).
# Project-invite emails point at {STUDIO_PUBLIC_URL}/invitations/project/<id>.
# -----------------------------------------------------------------------------
# (NUXT_PUBLIC_APP_URL below already carries this; the project-invite endpoint
#  should be migrated off BETTER_AUTH_URL onto NUXT_PUBLIC_APP_URL — see report.)

# -----------------------------------------------------------------------------
# S3-compatible object storage (MinIO locally, UpCloud Object Storage in prod)
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=grundtone-studio
S3_ACCESS_KEY_ID=grundtone
S3_SECRET_ACCESS_KEY=grundtone_dev

# -----------------------------------------------------------------------------
# Nuxt public runtime config (shipped to the browser — never put secrets here)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_APP_URL=http://localhost:3000
# 🔴 REQUIRED IN PRODUCTION (KH-1178): the app refuses to start without it, so
# the two install screens can never fall back to two different hosts. Outside
# production an empty value falls back to the request origin.
# Where saas-client install snippets point. In prod this is cdn.grundtone.com;
# locally we self-host /k/<key>/<file> via the studio's Nitro server.
NUXT_PUBLIC_CDN_BASE=http://localhost:3000
# Surfaced in /api/healthz so deploys can verify image version. Either set
# explicitly per deploy ('v0.3.0', 'sha-abc1234') or leave for the
# auto-generated value in the Docker image labels.
# NUXT_PUBLIC_APP_VERSION=dev

# -----------------------------------------------------------------------------
# Sentry — leave DSN empty in dev so init becomes a no-op. Populate per
# environment via GitHub Environment secrets (separate Sentry projects for
# staging vs production keeps alerts cleanly separated).
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SENTRY_DSN=
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
# SENTRY_AUTH_TOKEN — set in CI only; uploads source maps during the build.
# Not loaded at runtime.

# -----------------------------------------------------------------------------
# Outbound email — Postmark in staging/prod via SMTP. NB: Postmark har INGEN
# EU-region — al behandling sker i USA (DPF + SCC'er er overførselsgrundlaget;
# jura-fund 2026-08-03, TEM-vs-Postmark-beslutning ligger hos Allan). If SMTP_HOST
# is empty, emails are logged to the server console instead of sent — useful
# for invite/magic-link dev flows. Provisioning runbook in
# `docs/email/postmark-setup.md`; DNS pre-reqs in `docs/email/dns-setup.md`.
#
# Postmark uses the Server Token as both SMTP user AND password (not a typo).
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Grundtone Studio <no-reply@grundtone.com>

# -----------------------------------------------------------------------------
# Postmark webhook — bounce/spam/delivery tracking. Basic-Auth-protected
# endpoint at /api/email/webhook. Set values to anything sufficiently random;
# the same values go into Postmark dashboard → Webhooks → Add Webhook.
# -----------------------------------------------------------------------------
POSTMARK_WEBHOOK_USER=
POSTMARK_WEBHOOK_PASS=

# Account-deletion webhook from central auth → POST /api/account/deleted
ACCOUNT_DELETED_WEBHOOK_SECRET=

# GDPR art.20 export — bilateral secret for the s2s call from
# GET /api/account/export → central auth POST /api/auth/identity-export.
# Same value provisioned on both sides (auth + studio). Unset → the identity
# block soft-fails (retryable marker) and the export returns Studio data only.
IDENTITY_EXPORT_SERVICE_SECRET=

# -----------------------------------------------------------------------------
# Bunny.net purge — invalidates the CDN cache for /k/<key>/* on publish +
# activate so customers see new tokens immediately. Empty disables the purge
# (dev/test); production should set it. BUNNY_PURGE_API_KEY is the Account
# API key from Bunny dashboard → Account Settings → API. NOT the same as the
# storage-zone password used by the SDK upload script.
# -----------------------------------------------------------------------------
BUNNY_PURGE_API_KEY=

# =============================================================================
# Not loaded from .env — listed for reference only
# =============================================================================
# These are surfaced to CI / deploy targets via GitHub Environment secrets
# and never need a value in this file:
#
#   STAGING_HOST           — staging VM hostname / IP
#   STAGING_USER           — SSH user with permission to docker compose up
#   STAGING_SSH_KEY        — private key (one-line) for the SSH user
#   PROD_HOST, PROD_USER, PROD_SSH_KEY — no longer read by any workflow since
#                            build.yml's deploy-production job was removed.
#   TURBO_TOKEN            — auth token for the Turbo remote cache. Set as a
#                            repo secret pointing at Vercel's hosted remote
#                            cache (https://turbo.build/repo/docs/core-concepts/
#                            remote-caching). When unset, Turbo falls back to
#                            local cache; CI keeps working, just slower.
#   TURBO_TEAM             — Vercel team slug paired with TURBO_TOKEN.
#   POSTMARK_WEBHOOK_SECRET — verifies webhook signatures (#77)

# -----------------------------------------------------------------------------
# Generic OIDC login (optional; AUTH_MODE=oidc) — design: docs/design/standalone-oidc.md
# -----------------------------------------------------------------------------
# Unset keeps the central-auth behaviour above. With AUTH_MODE=oidc, AUTHORIZER
# must be `local`. The login routes exist; browser sessions arrive in a later
# change, so a successful login does not yet sign anyone in.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=            # omit for a public (PKCE-only) client
# OIDC_SCOPES=openid email profile
# OIDC_REDIRECT_URI=             # default: {NUXT_PUBLIC_APP_URL}/api/oidc/callback
# OIDC_ID_TOKEN_ALG=RS256        # the one ID-token signing algorithm accepted
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# OIDC_ALLOWED_EMAIL_DOMAINS=    # comma-separated; empty = no restriction
# OIDC_JIT=on                    # create the Studio user at first login
